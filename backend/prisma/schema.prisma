
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model ServiceRequest {
  id            Int   @id @default(autoincrement())
  employeeId    Int
  departmentId  Int
  handlerId     Int?
  title         String
  description   String
  status        String
}
